/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: image-compression=(), accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none';

/images/*
  Cache-Control: public, max-age=31536000;
  Cross-Origin-Resource-Policy: same-origin
  Access-Control-Allow-Origin: https://kexueyi.com, https://kexueyi.netlify.app
  X-Robots-Tag: noindex, noarchive, noimageindex
  Content-Security-Policy: img-src 'self' data: https://kexueyi.netlify.app;
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/images/gallery/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex, noarchive
  Content-Security-Policy: img-src 'self' data: https://kexueyi.netlify.app;

/images/KeXueyi.png
  Cache-Control: private, no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Cross-Origin-Resource-Policy: same-origin
  Access-Control-Allow-Origin: https://kexueyi.com, https://kexueyi.netlify.app
  X-Robots-Tag: noindex, noarchive, noimageindex
  Content-Security-Policy: img-src 'self'; default-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer